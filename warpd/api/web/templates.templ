package web

import (
	"fmt"
)

templ dashboardIcon() {
	<svg class={ navIcon() } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path>
	</svg>
}

templ appsIcon() {
	<svg class={ navIcon() } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
		<path d="m3.3 7 8.7 5 8.7-5"></path>
		<path d="M12 22V12"></path>
	</svg>
}

templ settingsIcon() {
	<svg class={ navIcon() } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
		<circle cx="12" cy="12" r="3"></circle>
	</svg>
}

templ userIcon() {
	<svg class={ pillIcon() } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
		<path d="M16 3.128a4 4 0 0 1 0 7.744"></path>
		<path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
		<circle cx="9" cy="7" r="4"></circle>
	</svg>
}

templ moonIcon() {
	<svg class={ buttonIcon() } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
	</svg>
}

templ Layout(title string, identityLabel string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/assets/css/tokens.css"/>
			<link rel="stylesheet" href="/assets/css/components.css"/>
			<script src="/assets/js/htmx.min.js"></script>
			<script src="/assets/js/keyboard.js" defer></script>
		</head>
		<body>
			<div class={ appFrame(), "responsive-grid" }>
				<aside class={ sidebar() } aria-label="Workspace">
					<a class={ brand() } href="/" data-navigable>
						<span class={ brandMark() } aria-hidden="true">W</span>
						<span>Warpgate</span>
					</a>
					<nav class={ sidebarNav() } aria-label="Primary">
						<a class={ sidebarLink() } href="/" data-navigable>@dashboardIcon()<span>Dashboard</span></a>
						<a class={ sidebarLink() } href="/apps" data-navigable>@appsIcon()<span>Apps</span></a>
						<a class={ sidebarLink() } href="/settings" data-navigable>@settingsIcon()<span>Settings</span></a>
					</nav>
					<div class={ sidebarFooter() }>
						<span class={ pill() }>Control plane</span>
						<span class={ identityPill(), identityAuthStyle(identityLabel) }>@userIcon()<span>{ navigationIdentityLabel(identityLabel) }</span></span>
						<button class={ iconButton() } type="button" aria-label="Toggle theme" data-theme-toggle>@moonIcon()</button>
					</div>
				</aside>
				<main class={ appMain() } id="main" tabindex="-1">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ Dashboard(data DashboardPage) {
	@Layout(data.Title, data.IdentityLabel) {
		<h1 class={ pageTitle() }>Dashboard</h1>
		if data.Error != "" {
			<p class={ errorBox() }>{ data.Error }</p>
		}
		<div class={ dashboardGrid(), "responsive-grid" }>
			<section class={ panel() }>
				<div class={ sectionHeading() }>
					<div><p class={ eyebrow() }>Repository</p><h2 class={ panelTitle() }>Sync state</h2></div>
					<form method="post" action="/sync/config/check-now"><button class={ primaryButton() } type="submit">Check now</button></form>
				</div>
				if data.Dashboard.RepositoryAttached {
					<p><code class={ codeText() }>{ data.Dashboard.Repository.Owner + "/" + data.Dashboard.Repository.Repo }</code></p>
					<p>Branch <code class={ codeText() }>{ data.Dashboard.Repository.Branch }</code></p>
					if data.Dashboard.Repository.Path != "" {
						<p>Path <code class={ codeText() }>{ data.Dashboard.Repository.Path }</code></p>
					}
					<p>Config commit <code class={ codeText() }>{ data.Dashboard.ConfigCursor.LastObservedCommit }</code></p>
					<p>Last checked { data.Dashboard.ConfigCursor.LastCheckedAt.String() }</p>
					if data.Dashboard.ConfigCursor.LastError != "" {
						<p class={ errorBox() }>{ data.Dashboard.ConfigCursor.LastError }</p>
					}
				} else {
					<p>No repository attached.</p>
				}
			</section>
			<section class={ panel() }>
				<div class={ sectionHeading() }><div><p class={ eyebrow() }>Overview</p><h2 class={ panelTitle() }>Fleet</h2></div></div>
				<p><span class={ pill() }>{ fmt.Sprint(data.Dashboard.AppCount) } apps</span></p>
				<p><span class={ pill() }>{ fmt.Sprint(data.Dashboard.ImageUpdates) } image updates</span></p>
			</section>
		</div>
	}
}

templ Apps(data AppsPage) {
	@Layout(data.Title, data.IdentityLabel) {
		<h1 class={ pageTitle() }>Apps</h1>
		if data.Error != "" {
			<p class={ errorBox() }>{ data.Error }</p>
		}
		<section class={ panel() }>
			<div class={ sectionHeading() }>
				<div><p class={ eyebrow() }>Desired state</p><h2 class={ panelTitle() }>Observed apps</h2></div>
				<form method="post" action="/sync/images/check-now"><button class={ primaryButton() } type="submit">Check now</button></form>
			</div>
			<div class={ tableWrap() }>
				<table class={ tableView() }>
					<thead><tr><th class={ tableHead() } scope="col">App</th><th class={ tableHead() } scope="col">Config commit</th><th class={ tableHead() } scope="col">Path</th></tr></thead>
					<tbody>
						for index, app := range data.Apps {
							<tr class={ tableRowStyle(index) }><td class={ tableCell() }><a class={ tableLink() } href={ templ.URL("/apps/" + app.Name) }>{ app.Name }</a></td><td class={ tableCell() }><code class={ codeText() }>{ app.ConfigCommit }</code></td><td class={ tableCell() }><code class={ codeText() }>{ app.Path }</code></td></tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}

templ AppDetail(data AppDetailPage) {
	@Layout(data.Title, data.IdentityLabel) {
		<h1 class={ pageTitle() }>{ data.Detail.App.Name }</h1>
		if data.Error != "" {
			<p class={ errorBox() }>{ data.Error }</p>
		}
		<div class={ detailGrid(), "responsive-grid" }>
			<section class={ panel() }>
				<div class={ sectionHeading() }><div><p class={ eyebrow() }>Config</p><h2 class={ panelTitle() }>Current YAML</h2></div><a class={ primaryButton() } href={ templ.URL("/apps/" + data.Detail.App.Name + "/edit") }>Edit deploy data</a></div>
				<div class={ preBlock(), yamlBox(), yamlDocument() }>@templ.Raw(renderYAMLHTML(data.Detail.App.RawYAML))</div>
			</section>
			<aside class={ panel() }>
				<p class={ eyebrow() }>Config commit</p>
				<p><code class={ codeText() }>{ data.Detail.App.ConfigCommit }</code></p>
				<p class={ eyebrow() }>Path</p>
				<p><code class={ codeText() }>{ data.Detail.App.Path }</code></p>
			</aside>
		</div>
		<section class={ panel() }>
			<div class={ sectionHeading() }><div><p class={ eyebrow() }>History</p><h2 class={ panelTitle() }>Releases</h2></div></div>
			<div class={ tableWrap() }>
				<table class={ tableView() }>
					<thead><tr><th class={ tableHead() } scope="col">Release</th><th class={ tableHead() } scope="col">Status</th><th class={ tableHead() } scope="col">Commit</th><th class={ tableHead() } scope="col">Action</th></tr></thead>
					<tbody>
						for index, item := range data.Detail.Releases {
							<tr class={ tableRowStyle(index) }>
								<td class={ tableCell() }><a class={ tableLink() } href={ templ.URL("/releases/" + item.ID) }><code class={ codeText() }>{ item.ID }</code></a></td>
								<td class={ tableCell() }><span class={ statusBase(), statusStyle(item.Status) }>{ string(item.Status) }</span></td>
								<td class={ tableCell() }><code class={ codeText() }>{ item.ConfigCommit }</code></td>
								<td class={ tableCell() }><form method="post" action={ templ.URL("/releases/" + item.ID + "/deploy") }><button class={ primaryButton() } type="submit">Deploy release</button></form></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		<section class={ panel() }>
			<div class={ sectionHeading() }><div><p class={ eyebrow() }>History</p><h2 class={ panelTitle() }>Deployments</h2></div></div>
			<div class={ tableWrap() }>
				<table class={ tableView() }>
					<thead><tr><th class={ tableHead() } scope="col">Deployment</th><th class={ tableHead() } scope="col">Status</th><th class={ tableHead() } scope="col">Started</th><th class={ tableHead() } scope="col">Error</th></tr></thead>
					<tbody>
						for index, item := range data.Detail.Deployments {
							<tr class={ tableRowStyle(index) }>
								<td class={ tableCell() }><code class={ codeText() }>{ item.ID }</code></td>
								<td class={ tableCell() }><span class={ statusBase(), statusStyle(item.Status) }>{ string(item.Status) }</span></td>
								<td class={ tableCell() }>{ item.StartedAt.String() }</td>
								<td class={ tableCell() }>{ item.ErrorMessage }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}

templ AppEdit(data AppEditPage) {
	@Layout(data.Title, data.IdentityLabel) {
		<h1 class={ pageTitle() }>Edit Deploy Data</h1>
		if data.Error != "" {
			<p class={ errorBox() }>{ data.Error }</p>
		}
		<div class={ managementShell(), "responsive-grid" }>
			<form class={ panel() } method="post" action={ templ.URL("/apps/" + data.App.Name + "/commit") }>
				<div class={ sectionHeading() }><div><p class={ eyebrow() }>Release</p><h2 class={ panelTitle() }>Service image</h2></div></div>
				<label class={ field() }>Service<input class={ control() } name="service" value={ data.Service } required/></label>
				<label class={ field() }>Image tag<input class={ control() } name="image_tag"/></label>
				<label class={ field() }>Image digest<input class={ control() } name="image_digest"/></label>
				<div class={ formActions() }><button class={ primaryButton() } type="submit">Commit release</button></div>
			</form>
			<section class={ panel() }>
				<div class={ sectionHeading() }><div><p class={ eyebrow() }>Preview</p><h2 class={ panelTitle() }>Current YAML</h2></div></div>
				<pre class={ preBlock() }>{ data.App.RawYAML }</pre>
			</section>
		</div>
	}
}

templ ReleaseDetail(data ReleasePage) {
	@Layout(data.Title, data.IdentityLabel) {
		<h1 class={ pageTitle() }>{ "Release " + data.Release.ID }</h1>
		if data.Error != "" {
			<p class={ errorBox() }>{ data.Error }</p>
		}
		<section class={ panel() }>
			<div class={ sectionHeading() }>
				<div><p class={ eyebrow() }>Release</p><h2 class={ panelTitle() }>Manifest inputs</h2></div>
				<form method="post" action={ templ.URL("/releases/" + data.Release.ID + "/deploy") }><button class={ primaryButton() } type="submit">Deploy release</button></form>
			</div>
			<p><span class={ statusBase(), statusStyle(data.Release.Status) }>{ string(data.Release.Status) }</span></p>
			<p>GitHub commit <code class={ codeText() }>{ data.Release.ConfigCommit }</code></p>
			<pre class={ preBlock() }>{ data.Release.ManifestJSON }</pre>
		</section>
	}
}

templ Settings(data SettingsPage) {
	@Layout(data.Title, data.IdentityLabel) {
		<h1 class={ pageTitle() }>Settings</h1>
		if data.Error != "" {
			<p class={ errorBox() }>{ data.Error }</p>
		}
		<section class={ panel() }>
			<div class={ sectionHeading() }>
				<div><p class={ eyebrow() }>GitHub</p><h2 class={ panelTitle() }>Account</h2></div>
				<span class={ statusBase(), githubAuthStatusStyle(data.GitHubAuth) }>{ githubAuthLabel(data.GitHubAuth) }</span>
			</div>
			if !data.GitHubAuth.Configured {
				<p>Set a GitHub App client ID before connecting GitHub.</p>
			} else if data.GitHubAuth.Authenticated {
				<p>Connected as <code class={ codeText() }>{ githubAuthLabel(data.GitHubAuth) }</code>.</p>
				<form method="post" action="/auth/github/disconnect">
					<button class={ primaryButton() } type="submit">Disconnect</button>
				</form>
			} else {
				if data.GitHubAuth.Error != "" {
					<p class={ errorBox() }>{ data.GitHubAuth.Error }</p>
				}
				if data.GitHubAuth.UserCode != "" {
					<p>Open <a href={ templ.URL(data.GitHubAuth.VerificationURI) }>{ data.GitHubAuth.VerificationURI }</a> and enter <code class={ codeText() }>{ data.GitHubAuth.UserCode }</code>.</p>
					<form method="post" action="/auth/github/complete">
						<button class={ primaryButton() } type="submit">Complete sign in</button>
					</form>
				} else {
					<form method="post" action="/auth/github/start">
						<button class={ primaryButton() } type="submit">Connect GitHub</button>
					</form>
				}
			}
		</section>
		<section class={ panel() }>
			<div class={ sectionHeading() }><div><p class={ eyebrow() }>GitHub</p><h2 class={ panelTitle() }>Attached repository</h2></div></div>
			<form method="post" action="/settings/repository">
				<label class={ field() }>Owner<input class={ control() } name="owner" value={ data.Repository.Owner } required/></label>
				<label class={ field() }>Repo<input class={ control() } name="repo" value={ data.Repository.Repo } required/></label>
				<label class={ field() }>Branch<input class={ control() } name="branch" value={ data.Repository.Branch } required/></label>
				<label class={ field() }>Path<input class={ control() } name="path" value={ data.Repository.Path }/></label>
				<div class={ formActions() }><button class={ primaryButton() } type="submit">Attach repository</button></div>
			</form>
		</section>
	}
}
